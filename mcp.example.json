{
  "mcpServers": {
    "atlassian": {
      "disabled": true,
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "glean": {
      "disabled": true,
      "type": "http",
      "url": "https://YOUR-COMPANY-be.glean.com/mcp/default"
    },
    "slack": {
      "disabled": true,
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "${SLACK_CLIENT_ID}",
        "clientSecret": "${SLACK_CLIENT_SECRET}",
        "callbackPort": 33418,
        "scopes": "search:read.public search:read.private channels:history groups:history im:history mpim:history"
      }
    },
    "example-local": {
      "disabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything"
      ]
    },
    "example-token": {
      "disabled": true,
      "type": "http",
      "url": "https://mcp.example.internal/mcp",
      "headers": {
        "Authorization": "Bearer ${EXAMPLE_TOKEN}"
      },
      "exclude_tools": [
        "delete_*"
      ],
      "policy": {
        "search_*": "allow",
        "send_*": "ask"
      },
      "timeout": 120
    }
  }
}
